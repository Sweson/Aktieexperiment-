// ÖvningsHub Sverige · Prisma schema
//
// Källa: docs/KRAVSPEC.md §4.2 (Multi-tenant och rollramverk)
// och CLAUDE.md §1 (klassmodellen är två nivåer).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tillåtna klassningsvärden. SPEGLAS i `packages/classification/src/index.ts`.
/// Att utöka detta enum är en HITL-gate (CLAUDE.md §5.1).
enum Classification {
  open
  internal
}

/// Hierarkityper för svensk civil beredskapsstruktur. Försvarssektorn
/// är medvetet inte modellerad (kravspec §4.2 F-02.1).
enum OrganizationKind {
  national
  preparedness_sector
  civil_area
  county_administrative_board
  region
  state_authority
  municipality
  business
  healthcare_provider
  ngo
  unit
}

/// Roller enligt MSB Övningsvägledning + HSEEP. Kravspec §4.2 F-02.2.
enum ExerciseRole {
  exercise_director // ÖL
  local_exercise_director // LÖL
  game_director // SL
  module_exercise_director // MÖL
  evaluation_director // UL
  local_evaluator // LU
  logistics // LOG
  planner // PL
  sim_cell
  excon
  player
  observer
  mentor
  red_team // i etisk-hacking-mening
  vip
  platform_admin
  tenant_admin
}

model Tenant {
  id        String           @id @default(uuid()) @db.Uuid
  slug      String           @unique
  name      String
  kind      OrganizationKind
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  users       User[]
  memberships Membership[]
  exercises   Exercise[]

  @@index([kind])
  @@map("tenant")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String
  givenName     String    @map("given_name")
  familyName    String    @map("family_name")
  oidcSubject   String?   @unique @map("oidc_subject")
  bankIdSubject String?   @unique @map("bankid_subject")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("user")
}

/// Koppling mellan användare och en specifik övning eller globalt över
/// tenanten. För platformsadmin/tenantadmin kan exerciseId vara null.
model Membership {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       ExerciseRole
  exerciseId String?      @map("exercise_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  /// En användare får högst en roll per övning (kravspec §4.2 F-02.2 AC1).
  @@unique([tenantId, userId, exerciseId])
  @@index([tenantId, role])
  @@index([userId])
  @@map("membership")
}

/// MSB:s 12 generella förmågor (seedade i T-027).
model Capability {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  objectives ExerciseObjective[]
  mselEvents MselEvent[]

  @@map("capability")
}

enum ExerciseStatus {
  draft
  planning
  approved
  in_progress
  completed
  cancelled
  archived
}

enum ExerciseFormat {
  ttx // Tabletop exercise
  drill
  functional
  full_scale
  workshop
}

model Exercise {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  name           String
  slug           String
  summary        String?
  format         ExerciseFormat
  status         ExerciseStatus @default(draft)
  classification Classification @default(internal)
  startsAt       DateTime?      @map("starts_at")
  endsAt         DateTime?      @map("ends_at")
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  objectives  ExerciseObjective[]
  mselEvents  MselEvent[]
  memberships Membership[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, classification])
  @@map("exercise")
}

model ExerciseObjective {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  exerciseId     String         @map("exercise_id") @db.Uuid
  capabilityId   String?        @map("capability_id") @db.Uuid
  code           String
  description    String
  classification Classification @default(internal)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  capability Capability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  mselEvents MselEvent[]

  @@unique([exerciseId, code])
  @@index([tenantId, exerciseId])
  @@map("exercise_objective")
}

enum MselInjectMode {
  push
  pull
  conditional
}

enum MselStatus {
  draft
  approved
  scheduled
  released
  acknowledged
  completed
  cancelled
}

/// Master Scenario Events List enligt HSEEP (kravspec §4.3 F-04.1).
/// Fältnamnen följer HSEEP-konventionen: scenario_time är T+hh:mm,
/// real_time är wall clock, key_event flaggar avgörande beslutspunkter.
model MselEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  exerciseId          String         @map("exercise_id") @db.Uuid
  objectiveId         String?        @map("objective_id") @db.Uuid
  capabilityId        String?        @map("capability_id") @db.Uuid
  eventNo             Int            @map("event_no")
  scenarioTime        DateTime       @map("scenario_time")
  realTime            DateTime?      @map("real_time")
  fromRole            String?        @map("from_role")
  toRole              String?        @map("to_role")
  mode                MselInjectMode @default(push)
  message             String
  expectedResponse    String?        @map("expected_response")
  assignedController  String?        @map("assigned_controller")
  status              MselStatus     @default(draft)
  keyEvent            Boolean        @default(false) @map("key_event")
  classification      Classification @default(internal)
  conditionExpression String?        @map("condition_expression")
  attachmentKeys      String[]       @default([]) @map("attachment_keys")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  exercise   Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  objective  ExerciseObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  capability Capability?        @relation(fields: [capabilityId], references: [id], onDelete: SetNull)

  @@unique([exerciseId, eventNo])
  @@index([exerciseId, scenarioTime])
  @@index([tenantId, status])
  @@index([tenantId, classification])
  @@map("msel_event")
}

/// Append-only audit log med hashkedja (CLAUDE.md §1.6, kravspec §4.9 F-11.3).
/// UPDATE och DELETE på denna tabell är blockerade av en Postgres rule
/// (`prisma/sql/audit_event_immutability.sql`). Migration som rör tabellen
/// kräver HITL-godkännande (CLAUDE.md §5.2).
model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String?        @map("tenant_id") @db.Uuid
  sequence       BigInt
  prevHash       String         @map("prev_hash") @db.Char(64)
  hash           String         @unique @db.Char(64)
  timestamp      DateTime
  actorId        String         @map("actor_id")
  actorKind      String         @map("actor_kind")
  action         String
  targetId       String         @map("target_id")
  targetKind     String         @map("target_kind")
  classification Classification
  payload        Json
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([tenantId, sequence])
  @@index([tenantId, action])
  @@index([targetKind, targetId])
  @@index([timestamp])
  @@map("audit_event")
}
