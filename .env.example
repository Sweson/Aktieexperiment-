# ÖvningsHub Sverige · lokal utveckling
#
# Kopiera till `.env` och justera. Riktiga produktionsvärden ligger
# UTANFÖR repot (KMS / hosted secret store). Inga hemligheter får
# committas — gitleaks blockerar (CLAUDE.md §1.3).

# Database
POSTGRES_USER=ovh
POSTGRES_PASSWORD=ovh-dev-only
POSTGRES_DB=ovh
DATABASE_URL=postgresql://ovh:ovh-dev-only@localhost:5432/ovh?schema=public

# Object storage (MinIO i dev, S3-kompatibel)
MINIO_ROOT_USER=ovh-dev
MINIO_ROOT_PASSWORD=ovh-dev-only
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ovh-dev

# NATS JetStream
NATS_URL=nats://localhost:4222

# Mail (MailHog i dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# Keycloak (dev-IdP)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
OIDC_ISSUER=http://localhost:8080/realms/ovh
OIDC_CLIENT_ID=ovh-api
OIDC_CLIENT_SECRET=replace-me-in-dev

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
