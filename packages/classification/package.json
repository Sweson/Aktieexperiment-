{
  "name": "@ovh/classification",
  "version": "0.0.0",
  "private": true,
  "description": "Klassmodell (open/internal) och DLP — säkerhetskritisk",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dlp": {
      "types": "./dist/dlp.d.ts",
      "default": "./dist/dlp.js"
    },
    "./fastify": {
      "types": "./dist/fastify-plugin.d.ts",
      "default": "./dist/fastify-plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify-plugin": "5.0.1",
    "zod": "3.23.8"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.4",
    "fastify": "5.0.0",
    "vitest": "2.1.4"
  }
}
